{
  "$id": "NativeReadingsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["commands", "readings"],
  "properties": {
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "readings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["exit"],
        "properties": {
          "exit": {"type": ["integer", "null"]},
          "output": {"type": "string"},
          "artifact": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
          }
        },
        "oneOf": [{"required": ["output"]}, {"required": ["artifact"]}]
      }
    }
  }
}
