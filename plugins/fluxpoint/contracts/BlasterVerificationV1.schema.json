{
  "$id": "BlasterVerificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "complete",
    "runId",
    "configSha256",
    "snapshot",
    "toolchain",
    "checks",
    "regressions",
    "logs"
  ],
  "properties": {
    "schema": {
      "enum": [
        "BlasterVerificationV1"
      ]
    },
    "status": {
      "enum": [
        "passed"
      ]
    },
    "complete": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "configSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "inputs",
        "sha256"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lean",
        "z3",
        "lakeExecutableSha256",
        "z3ExecutableSha256",
        "dependencies",
        "leanVersionOutput",
        "z3VersionOutput",
        "environmentSha256"
      ],
      "properties": {
        "lean": {
          "type": "string",
          "minLength": 1
        },
        "z3": {
          "type": "string",
          "minLength": 1
        },
        "lakeExecutableSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "z3ExecutableSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "leanVersionOutput": {
          "type": "string",
          "minLength": 1
        },
        "z3VersionOutput": {
          "type": "string",
          "minLength": 1
        },
        "environmentSha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "module",
          "declaration",
          "witness",
          "scope",
          "expected",
          "trust",
          "seed",
          "assumptions",
          "observed",
          "witnessObserved",
          "model",
          "bindings",
          "axioms",
          "query",
          "status",
          "variables"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "declaration": {
            "type": "string",
            "minLength": 1
          },
          "witness": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "valid",
              "falsified"
            ]
          },
          "trust": {
            "enum": [
              "solver"
            ]
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed": {
            "enum": [
              "valid",
              "falsified",
              "undetermined"
            ]
          },
          "witnessObserved": {
            "enum": [
              "valid"
            ]
          },
          "model": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bindings": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "Nat",
                    "Int",
                    "Bool",
                    "String"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "boolean",
                    "string"
                  ]
                }
              }
            }
          },
          "axioms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "query": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed"
            ]
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cexId",
          "check",
          "bindings",
          "observed",
          "status"
        ],
        "properties": {
          "cexId": {
            "type": "string",
            "pattern": "^cex_[0-9a-f]{12}$"
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "Nat",
                    "Int",
                    "Bool",
                    "String"
                  ]
                },
                "value": {
                  "type": [
                    "integer",
                    "boolean",
                    "string"
                  ]
                }
              }
            }
          },
          "observed": {
            "enum": [
              "valid"
            ]
          },
          "status": {
            "enum": [
              "passed"
            ]
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "description": "A complete passing solver-trusted machine receipt. Error/incomplete receipts are not verification claims. Revalidate with blaster.py --check and independently attest the declared gate; this JSON shape alone grants no execution or kernel-proof authority."
}
