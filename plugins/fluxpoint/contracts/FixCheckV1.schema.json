{
  "$id": "FixCheckV1",
  "type": "object",
  "required": [
    "verdict",
    "findings",
    "evidence",
    "blockers"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "severity",
          "defectClass",
          "invariant",
          "classRewire",
          "measurement",
          "origin",
          "originEvidence"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "defectClass": {
            "type": "string",
            "minLength": 1
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "classRewire": {
            "type": "string",
            "minLength": 1
          },
          "measurement": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "origin": {
            "enum": [
              "pre-existing",
              "incomplete-fix",
              "fix-introduced",
              "cross-slice",
              "spec-text"
            ],
            "description": "Classify the demonstrated harm by replay, never by code location or git log -S identifiers: base reproduction in a targeted defect class is incomplete-fix, outside targets is pre-existing; first reproduction on a round patch is fix-introduced; only an integrated patch reproduces is cross-slice; requirement/scope/argv/graph text defects are spec-text."
          },
          "introducedIn": {
            "type": "integer",
            "minimum": 1,
            "description": "Actual first round whose complete patch reproduces the harm; required for fix-introduced, not the round in which the checker noticed it."
          },
          "originEvidence": {
            "type": "object",
            "description": "Executed control and reproduction observations tied to the supplied ORIGIN REPLAY CONTEXT. Every actual earlier patch and the current patch must be replayed on a clean launch-base archive. Missing tools, failed controls or unexecuted snapshots mean INCOMPLETE; they do not establish an origin. repair-replay.py produces this evidence.",
            "properties": {
              "base": {
                "type": "object",
                "required": [
                  "command",
                  "result",
                  "controlCommand",
                  "controlResult",
                  "controlPassed",
                  "reproduces",
                  "snapshot"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlCommand": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlResult": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlPassed": {
                    "const": true
                  },
                  "reproduces": {
                    "type": "boolean"
                  },
                  "snapshot": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "rounds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "command",
                    "result",
                    "controlCommand",
                    "controlResult",
                    "controlPassed",
                    "reproduces",
                    "item",
                    "round",
                    "patch"
                  ],
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "type": "string",
                      "minLength": 1
                    },
                    "controlCommand": {
                      "type": "string",
                      "minLength": 1
                    },
                    "controlResult": {
                      "type": "string",
                      "minLength": 1
                    },
                    "controlPassed": {
                      "const": true
                    },
                    "reproduces": {
                      "type": "boolean"
                    },
                    "item": {
                      "type": "string",
                      "minLength": 1
                    },
                    "round": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "patch": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "targetClasses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "integrated": {
                "type": "object",
                "required": [
                  "command",
                  "result",
                  "controlCommand",
                  "controlResult",
                  "controlPassed",
                  "reproduces",
                  "item",
                  "round",
                  "patch"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlCommand": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlResult": {
                    "type": "string",
                    "minLength": 1
                  },
                  "controlPassed": {
                    "const": true
                  },
                  "reproduces": {
                    "type": "boolean"
                  },
                  "item": {
                    "type": "string",
                    "minLength": 1
                  },
                  "round": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "patch": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "text": {
                "type": "object",
                "required": [
                  "kind",
                  "path",
                  "command",
                  "result"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "requirement",
                      "scope",
                      "argv",
                      "graph"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "fix-introduced"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "required": [
                "introducedIn"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "spec-text"
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "properties": {
                "originEvidence": {
                  "required": [
                    "text"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "origin": {
                  "enum": [
                    "pre-existing",
                    "incomplete-fix",
                    "fix-introduced",
                    "cross-slice"
                  ]
                }
              },
              "required": [
                "origin"
              ]
            },
            "then": {
              "properties": {
                "originEvidence": {
                  "required": [
                    "base",
                    "rounds",
                    "targetClasses"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reframe": {
      "type": "object",
      "required": [
        "classes",
        "invariant",
        "classRewire",
        "disposition",
        "measurement"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "classRewire": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "adopt",
            "refute",
            "remove"
          ]
        },
        "measurement": {
          "type": "object",
          "required": [
            "command",
            "result"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validated": {
          "type": "boolean"
        }
      }
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Commit ids actually checked by this PASS, not merely proposed by the fixer. Omit when no commit was checked.",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{7,40}$"
      }
    },
    "siblings": {
      "type": "array",
      "description": "Sibling claims on the fixer; independent executed observations on the checker. finding is a pinned targetClasses identity. NOT-APPLICABLE cites inspected snapshot file:line.",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "invariant",
          "axis",
          "surface",
          "attack",
          "control",
          "outcome",
          "reason"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "invariant": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "axis": {
            "enum": [
              "field",
              "encoding",
              "caller",
              "network",
              "role",
              "path"
            ]
          },
          "attack": {
            "type": "object",
            "required": [
              "command",
              "result"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "control": {
            "type": "object",
            "required": [
              "command",
              "result"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "outcome": {
            "enum": [
              "DEFENDED",
              "NOT-APPLICABLE"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "NOT-APPLICABLE"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "pattern": "[^\\s:]+:[0-9]+"
                }
              }
            }
          }
        ]
      }
    },
    "targetClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "diffCoverage": {
      "type": "object",
      "required": [
        "patchSha256",
        "hunks"
      ],
      "properties": {
        "patchSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "surface",
              "attack",
              "control"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "surface": {
                "enum": [
                  "outbound-calls",
                  "alarms",
                  "timers",
                  "caches",
                  "parsers",
                  "guards",
                  "other"
                ]
              },
              "attack": {
                "type": "object",
                "required": [
                  "command",
                  "result"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              },
              "control": {
                "type": "object",
                "required": [
                  "command",
                  "result"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        "operational": {
          "type": "object",
          "properties": {
            "latency": {
              "type": "object",
              "required": [
                "command",
                "result",
                "deadlineMs",
                "observedMs"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "deadlineMs": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "observedMs": {
                  "type": "number",
                  "minimum": 0
                },
                "pool": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "alarmRate": {
              "type": "object",
              "required": [
                "command",
                "result",
                "seriesPath",
                "seriesSha256",
                "durationSeconds",
                "falsePositives",
                "maxPerDay"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "seriesPath": {
                  "type": "string",
                  "minLength": 1
                },
                "seriesSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "durationSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "falsePositives": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxPerDay": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "if": {
    "required": [
      "verdict"
    ],
    "properties": {
      "verdict": {
        "const": "PASS"
      }
    }
  },
  "then": {
    "properties": {
      "findings": {
        "maxItems": 0
      },
      "blockers": {
        "maxItems": 0
      }
    },
    "required": [
      "targetClasses",
      "siblings",
      "diffCoverage"
    ],
    "allOf": [
      {
        "if": {
          "required": [
            "targetClasses"
          ],
          "properties": {
            "targetClasses": {
              "minItems": 1
            }
          }
        },
        "then": {
          "properties": {
            "siblings": {
              "minItems": 1
            }
          }
        }
      }
    ]
  }
}
