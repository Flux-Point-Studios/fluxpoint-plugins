{
  "$id": "SliceV1",
  "type": "object",
  "required": [
    "branch",
    "diffSummary",
    "testsAdded",
    "harnessCommand",
    "harnessExit",
    "evidence",
    "sharedResources"
  ],
  "properties": {
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "diffSummary": {
      "type": "string",
      "minLength": 20
    },
    "testsAdded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "harnessCommand": {
      "type": "string",
      "minLength": 1
    },
    "harnessExit": {
      "type": "integer"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "reframe": {
      "type": "object",
      "required": [
        "classes",
        "invariant",
        "classRewire",
        "disposition",
        "measurement"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "classRewire": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "adopt",
            "refute",
            "remove"
          ]
        },
        "measurement": {
          "type": "object",
          "required": [
            "command",
            "result"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validated": {
          "type": "boolean"
        }
      }
    },
    "packetEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "anchor",
          "op",
          "text",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "op": {
            "enum": [
              "replace",
              "append",
              "insertAfter"
            ]
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "sharedResources": {
      "type": "array",
      "description": "Every shared pool, executor, cache, lock or single-writer store to which this patch adds a writer or reader. Explicit [] means none. Name all affected users, including existing writers reached by a new reader.",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "writers",
          "readers"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "writers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "readers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
